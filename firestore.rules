rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/characters/{characterId} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validSave() {
        let d = request.resource.data;
        return d.keys().hasAll(['engine', 'payload', 'name', 'age', 'generation', 'updatedAt', 'revision'])
          && d.keys().hasOnly(['engine', 'payload', 'name', 'age', 'generation', 'updatedAt', 'revision'])
          && d.engine == 'o65m-replay-1'
          && d.payload is string && d.payload.size() < 800000
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.age is int && d.age >= 0 && d.age <= 200
          && d.generation is int && d.generation >= 1
          && d.revision is int
          && d.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && validSave() && request.resource.data.revision == 1;
      allow update: if owner() && validSave()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
  }
}
